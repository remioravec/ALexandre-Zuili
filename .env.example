# ═══ Moteur de réservation — variables d'environnement ═══
# À définir dans Vercel : Settings → Environment Variables.
# Aucune valeur par défaut n'est inventée : une variable absente fait répondre
# 503 avec son nom dans le message. Ne jamais committer de valeur réelle.

# ── Notion ──
# Intégration interne créée par un PROPRIÉTAIRE de l'espace de travail sur
# notion.so/my-integrations (capacités Read content + Insert content), puis
# partagée avec chaque base via ••• → Connexions.
NOTION_TOKEN=
# Base « Agenda trackdays » — relevée le 18/09/2026
NOTION_DB_TRACKDAYS=2c5f3377b8f2802ab153e3818a799abd
# Base « Réservations site » — créée par l'API le 18/09/2026, sous la page
# « Roulages », 20 propriétés conformes au §4.2.
NOTION_DB_RESERVATIONS=3dff3377b8f28166b015f7b2d3336354

# ── Google Agenda (OPTIONNEL) ──
# Non configuré : la réservation est enregistrée et notifiée, sans événement.
# Compte de service ; l'agenda cible doit être partagé avec son adresse en
# « Apporter des modifications aux événements ».
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# ── E-mail : UNE des deux voies suffit ──
# Voie 1 — Resend. Propre, mais tant que le domaine n'est pas vérifié chez
# Resend, seuls les envois vers l'adresse du titulaire du compte passent.
RESEND_API_KEY=
# Voie 2 — SMTP Gmail avec un mot de passe d'application. Écrit à n'importe
# qui immédiatement, ~500 envois par jour. C'est le repli prévu au §2.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Expéditeur affiché. À défaut, SMTP_USER est utilisé.
MAIL_FROM=
# Destinataires internes, séparés par des virgules.
MAIL_INTERNAL=guillaume60leger@gmail.com,administration@remi-oravec.fr

# ── Anti-abus (OPTIONNEL) ──
# Sans Upstash le service tourne, mais la limitation de débit devient locale
# à chaque instance et le verrou distribué disparaît. L'idempotence, elle,
# reste garantie : elle s'appuie sur la base Notion.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Origine autorisée (CORS) ──
ALLOWED_ORIGIN=https://apex-drive-one.vercel.app

# ── Mise en vente des dates ──
# `État` décrit le pipeline d'achat de GL, pas la disponibilité publique.
# Défaut : « Réservé » seul (le créneau est acquis). Plusieurs valeurs
# séparées par des virgules : ETATS_PUBLIABLES="Réservé,Contacté".
ETATS_PUBLIABLES=
# Exiger en plus la case ALZ (la voiture est du voyage).
EXIGER_ALZ=false
# Exiger en plus la case Loc — jamais cochée au 18/09/2026, donc 0 date.
EXIGER_LOC=false
# Nom d'une propriété de capacité, si elle est ajoutée à la base. Sans elle,
# RESERVATION_FERME ne peut rien décrémenter.
PROP_PLACES=

# ── Arbitrages ──
# false = demande (le créneau reste ouvert, option A du §5.4).
# true  = réservation ferme (décrémente Places au clic).
RESERVATION_FERME=false
# TODO-DATA §5.2 : la formule 200 km est annoncée « ou à deux ».
CAPACITE_200_A_DEUX=false
# TODO-DATA §5.3 : battement entre deux circuits. Absent = garde-fou inactif.
BUFFER_JOURS_MEME_CIRCUIT=0
BUFFER_JOURS_AUTRE_CIRCUIT=
